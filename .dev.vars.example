# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# OAuth + connections
PUBLIC_BASE_URL=http://localhost:8787
CONNECTIONS_KEY=base64-32-byte-key
OAUTH_GMAIL_CLIENT_ID=your-gmail-client-id
OAUTH_GMAIL_CLIENT_SECRET=your-gmail-client-secret
OAUTH_OUTLOOK_CLIENT_ID=your-outlook-client-id
OAUTH_OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OAUTH_OUTLOOK_TENANT=common
INBOUND_SHARED_SECRET=optional-shared-inbound-token
